<div id="book-page">
    <a href="/books">
     Back
    </a>
    <div class="container">
        <h1>{{book.title}}</h1>
        <p>This book have {{book.pageqty}} pages.</p>
        <div class="actions">
            <a href="/books/edit/{{book.id}}">Edit book</a>
            <form action="/books/remove/{{book.id}}" method="POST">
            <input type="submit" value="Remover">
            </form>
        </div>
    </div>
</div>